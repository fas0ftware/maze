# Copy to .env (git-ignored) and fill in. Load with:  set -a; source .env; set +a
# Never commit the real .env file.

# Required. Use a long random value, e.g.:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(18))'
MAZE_REAL_PASSWORD=

# Optional
MAZE_HOST=127.0.0.1
MAZE_PORT=5000
MAZE_DB_PATH=./maze.db
# MAZE_DELAY_ENABLED=0
# MAZE_SECRET_KEY=
