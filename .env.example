# Copy to .env (git-ignored) and fill in. Load with:  set -a; source .env; set +a
# Never commit the real .env file.

# Required: the Argon2id hash of the real password (never the password itself).
# Generate it with:  python -m app.hashtool real
# Keep the single quotes: the hash contains '$'.
MAZE_REAL_PASSWORD_HASH=''

# Optional
MAZE_HOST=127.0.0.1
MAZE_PORT=5000
MAZE_DB_PATH=./maze.db
# MAZE_LAYERS_PATH=./config/layers.json
# MAZE_LIB=./core/build/libmaze.so
# MAZE_DELAY_ENABLED=0
# MAZE_SECRET_KEY=
